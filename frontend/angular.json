{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": { "unchicks": {
    "projectType": "application", "root": "", "sourceRoot": "src",
    "architect": { "build": {
      "builder": "@angular/build:application",
      "options": {
        "outputPath": "dist/unchicks", "index": "src/index.html",
        "browser": "src/main.ts", "polyfills": ["zone.js"],
        "tsConfig": "tsconfig.json", "styles": ["src/styles.css"]
      },
      "configurations": { "production": { "outputHashing": "all" } },
      "defaultConfiguration": "production"
    } }
  } }
}
